{
  "name": "astromatch",
  "version": "3.1.0",
  "description": "AstroMatch — moteur de compatibilité astrologique déterministe, socle commercial sans licence astronomique payante",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "ASTROMATCH_EPHEMERIS_PROVIDER=astronomy-engine node --test",
    "demo": "ASTROMATCH_EPHEMERIS_PROVIDER=astronomy-engine node tools/demo.mjs",
    "production:check": "ASTROMATCH_EPHEMERIS_PROVIDER=astronomy-engine node tools/production_check.mjs",
    "provider:simulated:check": "ASTROMATCH_EPHEMERIS_PROVIDER=simulated node --input-type=module -e \"import('./js/astrology/ephemeris/ephemeris_adapter.js').then(m=>console.log(m.getEphemerisCapabilities()))\"",
    "build:runtime": "node tools/build_runtime.mjs",
    "build:mobile-web": "node tools/build_mobile_web.mjs"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "astronomy-engine": "2.1.19",
    "geo-tz": "^8.1.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "esbuild": "^0.28.2"
  }
}
