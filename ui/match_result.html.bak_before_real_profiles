<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport"
      content="width=device-width,initial-scale=1,viewport-fit=cover">

<title>AstroMatch — Match Result</title>

<script src="https://cdn.tailwindcss.com"></script>

<style>
  body {
    background:
      radial-gradient(circle at top, #312e81 0%, #0f172a 38%, #020617 100%);
  }

  .glass {
    background: rgba(15, 23, 42, .72);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(255,255,255,.08);
  }

  .score-ring {
    background:
      conic-gradient(#a78bfa 0deg 261deg, #334155 261deg 360deg);
  }
</style>
</head>

<body class="min-h-screen text-white">

<main class="max-w-xl mx-auto px-4 py-6 pb-10">

  <!-- HEADER -->
  <header class="flex items-center justify-between mb-6">
    <button
      onclick="history.back()"
      class="w-10 h-10 rounded-full glass text-xl">
      ←
    </button>

    <div class="text-center">
      <div class="text-xs uppercase tracking-[.25em] text-violet-300">
        ASTROMATCH
      </div>
      <div class="font-semibold">Résultat du match</div>
    </div>

    <button
      onclick="shareResult()"
      class="w-10 h-10 rounded-full glass text-xl">
      ↗
    </button>
  </header>


  <!-- PROFILES -->
  <section class="glass rounded-3xl p-5 mb-4">

    <div class="flex items-center justify-center gap-4">

      <div class="text-center">
        <div class="w-16 h-16 mx-auto rounded-full
                    bg-violet-500/20 border border-violet-300/30
                    flex items-center justify-center text-3xl">
          👤
        </div>
        <div class="mt-2 font-semibold" id="primaryName">Chargement…</div>
        <div class="text-xs text-slate-400">Profil principal</div>
      </div>

      <div class="text-2xl text-violet-300">×</div>

      <div class="text-center">
        <div class="w-16 h-16 mx-auto rounded-full
                    bg-pink-500/20 border border-pink-300/30
                    flex items-center justify-center text-3xl">
          ✨
        </div>
        <div class="mt-2 font-semibold" id="targetName">Chargement…</div>
        <div class="text-xs text-slate-400">Compatible</div>
      </div>

    </div>
  </section>


  <!-- GLOBAL SCORE -->
  <section class="glass rounded-3xl p-6 mb-4 text-center">

    <div class="text-xs uppercase tracking-[.25em] text-violet-300">
      Compatibilité globale
    </div>

    <div class="relative w-48 h-48 mx-auto my-5">

      <div class="score-ring absolute inset-0 rounded-full"></div>

      <div class="absolute inset-[10px] rounded-full
                  bg-slate-950
                  flex flex-col items-center justify-center">

        <div id="globalScore"
             class="text-5xl font-bold">
          …
        </div>

        <div class="text-sm text-slate-400">
          / 100
        </div>

      </div>
    </div>

    <div id="globalLabel"
         class="text-2xl font-bold text-violet-300">
      Calcul…
    </div>

    <div id="jsDiagnostic"
         class="mt-4 rounded-2xl bg-yellow-950/40 border border-yellow-500/30 p-4 text-sm text-yellow-300">
      JavaScript : initialisation…
    </div>

    <p id="summary"
       class="text-slate-300 mt-3 leading-relaxed">
      Calcul de la compatibilité…
    </p>

  </section>


  <!-- DOMAINS -->
  <section class="glass rounded-3xl p-5 mb-4">

    <div class="flex items-center justify-between mb-5">
      <h2 class="text-lg font-bold">
        Vos domaines
      </h2>

      <span class="text-xs text-slate-400">
        7 indicateurs
      </span>
    </div>

    <div id="domains"
         class="space-y-5">
    </div>

  </section>


  <!-- STRENGTHS -->
  <section class="glass rounded-3xl p-5 mb-4">

    <h2 class="text-lg font-bold mb-4">
      ⭐ Vos forces
    </h2>

    <div id="strengths"
         class="space-y-3">
    </div>

  </section>


  <!-- TENSIONS -->
  <section class="glass rounded-3xl p-5 mb-4">

    <h2 class="text-lg font-bold mb-4">
      ⚠️ Points de vigilance
    </h2>

    <div id="tensions"
         class="space-y-3">
    </div>

  </section>


  <!-- RELIABILITY -->
  <section id="reliability"
           class="glass rounded-3xl p-5 mb-4">
  </section>


  <!-- AI BUTTON -->
  <section class="glass rounded-3xl p-5 text-center">

    <div class="text-3xl mb-2">✨</div>

    <h2 class="font-bold text-lg">
      Comprendre votre match
    </h2>

    <p class="text-sm text-slate-400 mt-2 mb-4">
      L'IA pourra expliquer les résultats
      sans modifier le score AstroMatch.
    </p>

    <button
      onclick="explainMatch()"
      class="w-full py-3 rounded-2xl
             bg-gradient-to-r from-violet-600 to-fuchsia-600
             font-semibold">
      ✨ Explique-moi ce match
    </button>

  </section>

</main>


<script>
window.addEventListener("DOMContentLoaded", function() {
  const box = document.getElementById("jsDiagnostic");
  if (box) box.textContent = "JavaScript : page chargée, module en attente…";
});

window.addEventListener("error", function(e) {
  const box = document.getElementById("jsDiagnostic");
  if (box) {
    box.textContent =
      "ASTROMATCH JS DIAGNOSTIC — " +
      (e.message || "Erreur JavaScript inconnue");
  }
});

window.addEventListener("unhandledrejection", function(e) {
  const box = document.getElementById("jsDiagnostic");
  if (box) {
    box.textContent =
      "ASTROMATCH JS DIAGNOSTIC — " +
      (e.reason?.message || String(e.reason));
  }
});
</script>

<script type="module">

const API_URL = "http://127.0.0.1:3000/api/match";

const primaryInput = {
  role: "primary",
  first_name: "Alex",
  last_name: "",
  date: "1990-05-15",
  time: "14:30",
  time_known: true,
  place: "Paris, France",
  house_system: "whole_sign"
};

const targetInput = {
  role: "target",
  first_name: "Sam",
  last_name: "",
  date: "1992-11-03",
  time: "09:15",
  time_known: true,
  place: "Lyon, France",
  house_system: "whole_sign"
};

const diagnostic = document.getElementById("jsDiagnostic");

function status(message) {
  if (diagnostic) diagnostic.textContent = message;
}

function escapeHtml(value) {
  return String(value ?? "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
}

async function start() {
  try {
    status("Connexion à AstroMatch…");

    const response = await fetch(API_URL, {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        primary: primaryInput,
        target: targetInput
      })
    });

    if (!response.ok) {
      throw new Error(`API HTTP ${response.status}`);
    }

    const payload = await response.json();

    if (!payload.ok) {
      throw new Error(payload.error || "Erreur API inconnue");
    }

    const result = payload.result;

    status(
      `Calcul réel terminé — ${Math.round(result.score?.global ?? result.global?.score ?? 0)}/100`
    );

    const global = result.global;

    document.getElementById("globalScore").textContent =
      Math.round(global.score);

    document.getElementById("globalLabel").textContent =
      global.label;

    document.getElementById("summary").textContent =
      result.summary || "Compatibilité calculée par le moteur AstroMatch.";

    document.getElementById("primaryName").textContent =
      result.chartA?.profile_name ||
      primaryInput.first_name;

    document.getElementById("targetName").textContent =
      result.chartB?.profile_name ||
      targetInput.first_name;

    console.log("ASTROMATCH API RESULT", result);

  } catch (error) {

    console.error("AstroMatch API error:", error);

    status(
      "ERREUR API — " +
      escapeHtml(error?.message || String(error))
    );

    document.getElementById("summary").textContent =
      "Impossible de calculer ce match.";

  }
}

start();

</script>
