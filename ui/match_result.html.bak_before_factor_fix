    </button>
  </header>


  <!-- PROFILES -->
  <section class="glass rounded-3xl p-5 mb-4">

    <div class="flex items-center justify-center gap-4">

      <div class="text-center">
        <div class="w-16 h-16 mx-auto rounded-full
                    bg-violet-500/20 border border-violet-300/30
                    flex items-center justify-center text-3xl">
          👤
        </div>
        <div class="mt-2 font-semibold" id="primaryName">Chargement…</div>
        <div class="text-xs text-slate-400">Profil principal</div>
      </div>

      <div class="text-2xl text-violet-300">×</div>

      <div class="text-center">
        <div class="w-16 h-16 mx-auto rounded-full
                    bg-pink-500/20 border border-pink-300/30
                    flex items-center justify-center text-3xl">
