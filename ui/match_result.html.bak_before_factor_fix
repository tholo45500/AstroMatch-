<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport"
      content="width=device-width,initial-scale=1,viewport-fit=cover">

<title>AstroMatch — Match Result</title>

<script src="https://cdn.tailwindcss.com"></script>

<style>
  body {
    background:
      radial-gradient(circle at top, #312e81 0%, #0f172a 38%, #020617 100%);
  }

  .glass {
    background: rgba(15, 23, 42, .72);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(255,255,255,.08);
  }

  .score-ring {
    background:
      conic-gradient(#a78bfa 0deg 261deg, #334155 261deg 360deg);
  }

